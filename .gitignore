# Rust
target

# Node / Next
node_modules/
.next/
bun.lock
npm-debug.log*

# M-T1 (Tauri repurpose): Next.js static-export output directory — generated
# by `next build` with `output: 'export'`, consumed by `cargo tauri build`
# via `frontendDist: ../console/out`. Never committed.
console/out/

# local env
.env
.env.local

# run artifacts (evidence dirs are committed deliberately per-component)
scratch/
*.log

# OS / editor
.DS_Store
*.swp
# demo live-run evidence: commit the logs/report/snapshots, not the per-vehicle
# PX4 run roots or ULogs (reproducible via scripts/browser_live_test.sh)
fleet/tests/demo_artifacts/run/vehicle_*/

# setup live-test artifacts (regenerated per run; screenshots are committed)
fleet/fleet-runs/
fleet/tests/setup_browser_artifacts/
console/tsconfig.tsbuildinfo
# operator-map live-test artifacts (regenerated per run; screenshots are committed)
fleet/tests/o1_artifacts/
fleet/tests/map_browser_artifacts/
# runtime-plane live-test artifacts (regenerated per run, R-1)
fleet/tests/r1_artifacts/

# GCS v2 (M8): maplibre worker is a build artifact — regenerated by
# `prebuild` (scripts/copy-maplibre-worker.mjs), never committed. The
# whole public/maplibre/ directory is treated as build output.
console/public/maplibre/
