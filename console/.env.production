# M-T1 (Tauri repurpose): forces the frontend into direct mode at build
# time. The Tauri webview has no Caddy gateway, so all backend traffic
# must use absolute http://127.0.0.1:<port> URLs (see src/lib/conn.ts).
# This file is read by Next.js at build time; the build bakes the value
# into the static export's JS bundle.
# See docs/TAURI_APP_SPEC.md §5.1 and Appendix F.6.
NEXT_PUBLIC_RSIM_API_STYLE=direct
